FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    KARAOKE_MODEL_DIR=/app/models

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "numpy>=2,<3" "sherpa-onnx==2.0.1" "soundfile==0.14.0"

# Keep model download out of the first karaoke request.
RUN python - <<'PY'
import pathlib
import urllib.request

base = (
    "https://huggingface.co/csukuangfj/sherpa-onnx-spleeter-2stems-fp16/resolve/"
    "93ba771920ade509f8cbd6825b1a90856c797e08/"
)
expected = {"vocals.fp16.onnx": 19_681_017, "accompaniment.fp16.onnx": 19_681_024}
out = pathlib.Path("/app/models")
out.mkdir(parents=True, exist_ok=True)
for name, size in expected.items():
    path = out / name
    urllib.request.urlretrieve(base + name, path)
    actual = path.stat().st_size
    if actual != size:
        raise SystemExit(f"Unexpected size for {name}: {actual}")
PY

COPY backend/karaoke_worker.py /app/karaoke_worker.py

RUN groupadd -r -g 1000 karaoke \
    && useradd -r -u 1000 -g karaoke -d /app -s /usr/sbin/nologin karaoke \
    && mkdir -p /app/cache/karaoke/tmp \
    && chown -R karaoke:karaoke /app

USER karaoke
EXPOSE 8091
CMD ["python", "/app/karaoke_worker.py"]
