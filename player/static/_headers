# Cloudflare Pages response headers (copied into dist/ by SvelteKit).
# SvelteKit fingerprints everything in /_app/immutable, so those never change.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must revalidate so a new deploy is picked up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/_app/version.json
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/icons/*
  Cache-Control: public, max-age=604800
